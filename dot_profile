export PATH="$HOME/.atuin/bin:$HOME/.local/bin:$HOME/.local/toolbox:$HOME/.cargo/bin:/usr/local/bin:/bin:$PATH"
# eval "$(sops completion bash)"


eval "$(atuin init bash)"
eval "$($HOME/.config/vars)"
[ -s "$HOME/.config/envman/load.sh" ] && source "$HOME/.config/envman/load.sh"
. "$HOME/.cargo/env"

# toolbox-export: add exported binaries to PATH
case ":$PATH:" in
    *":$HOME/.local/toolbox:"*) ;;
    *) export PATH="$PATH:$HOME/.local/toolbox" ;;
esac
