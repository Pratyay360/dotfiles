[user]
	email = pratyaymustafi@outlook.com
	name = PRATYAY MUSTAFI
	signingKey = ssh.variant
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential "https://github.com"]
	helper = 
	helper = !/var/home/pmustafi/.pixi/envs/gh/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/var/home/pmustafi/.pixi/envs/gh/bin/gh auth git-credential
[core]
	hooksPath = /home/pmustafi/.local/share/ggshield/git-hooks
